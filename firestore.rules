rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Global Deny-All Catch-All (Default closed)
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit Connection Healthcheck Document (Read only, fixed document path)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // -------------------------------------------------------------------------
    // Common Validation Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // Entity Schema Validators
    // -------------------------------------------------------------------------
    function isValidUserProfile(data, uid) {
      return data.userId == uid &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        data.createdAt is number;
    }

    function isValidStudentProfile(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        data.stream is string && data.stream.size() <= 64 &&
        (!('classLevel' in data) || (data.classLevel is string && data.classLevel.size() <= 64)) &&
        (!('board' in data) || (data.board is string && data.board.size() <= 64)) &&
        data.createdAt is number;
    }

    function isValidTask(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        data.completed is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('priority' in data) || (data.priority in ['low', 'medium', 'high'])) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        (!('time' in data) || (data.time is string && data.time.size() <= 16)) &&
        data.createdAt is number;
    }

    function isValidSubject(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
        (!('color' in data) || (data.color is string && data.color.size() <= 32));
    }

    function isValidNote(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        (!('content' in data) || (data.content is string && data.content.size() <= 50000)) &&
        (!('pinned' in data) || data.pinned is bool) &&
        data.createdAt is number;
    }

    function isValidHabit(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
        (!('streak' in data) || data.streak is number) &&
        (!('completedDates' in data) || (data.completedDates is list && data.completedDates.size() <= 400)) &&
        data.createdAt is number;
    }

    function isValidGoal(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 100)) &&
        (!('completed' in data) || data.completed is bool) &&
        data.createdAt is number;
    }

    function isValidCalendarEvent(data, uid) {
      return data.userId == uid &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        (!('completed' in data) || data.completed is bool) &&
        data.createdAt is number;
    }

    function isValidCloudSync(data, uid) {
      return data.userId == uid &&
        data.lastSyncedAt is number &&
        data.version is string && data.version.size() <= 32 &&
        (!('payloadJson' in data) || (data.payloadJson is string && data.payloadJson.size() <= 500000));
    }

    function isValidSharedWorkspace(data) {
      return data.id is string && data.id.size() <= 128 &&
        data.type in ['tasks', 'notes'] &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 256 &&
        data.joinCode is string && data.joinCode.size() <= 32 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.memberIds is list && data.memberIds.size() <= 100 &&
        (!('allowInviteLink' in data) || data.allowInviteLink is bool) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('noteContent' in data) || (data.noteContent is string && data.noteContent.size() <= 50000)) &&
        (!('tasks' in data) || (data.tasks is list && data.tasks.size() <= 500)) &&
        data.createdAt is number;
    }

    function getWorkspaceDoc(wsId) {
      return get(/databases/$(database)/documents/shared_workspaces/$(wsId));
    }

    function isParentWorkspaceMemberOrOwner(wsId) {
      return isSignedIn() && exists(/databases/$(database)/documents/shared_workspaces/$(wsId)) && (
        request.auth.uid == getWorkspaceDoc(wsId).data.ownerId ||
        request.auth.uid in getWorkspaceDoc(wsId).data.memberIds
      );
    }

    function isParentWorkspaceOwner(wsId) {
      return isSignedIn() && exists(/databases/$(database)/documents/shared_workspaces/$(wsId)) &&
        request.auth.uid == getWorkspaceDoc(wsId).data.ownerId;
    }

    // Helper to verify field equality or mutual absence
    function isFieldUnchanged(field) {
      return (! (field in existing()) && ! (field in incoming())) ||
        (field in existing() && field in incoming() && incoming()[field] == existing()[field]);
    }

    // Check if security-sensitive workspace metadata fields are unmodified
    function isWorkspaceSecurityMetadataUnchanged() {
      return incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().type == existing().type &&
        incoming().joinCode == existing().joinCode &&
        incoming().memberIds == existing().memberIds &&
        isFieldUnchanged('allowInviteLink') &&
        isFieldUnchanged('members') &&
        isFieldUnchanged('description');
    }

    // Member collaborative edit: strictly whitelisted fields, cannot touch security fields
    function isLegitimateMemberUpdate() {
      return isSignedIn() &&
        request.auth.uid in existing().memberIds &&
        request.auth.uid != existing().ownerId &&
        isWorkspaceSecurityMetadataUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'tasks', 'noteContent', 'noteTags', 'updatedAt', 'lastModifiedBy'
        ]);
    }

    // Owner edit: owner cannot transfer ownership or mutate immutable creation/type/id metadata
    function isLegitimateOwnerUpdate() {
      return isSignedIn() &&
        request.auth.uid == existing().ownerId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().type == existing().type &&
        incoming().joinCode == existing().joinCode &&
        existing().ownerId in incoming().memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'tasks', 'noteContent', 'noteTags',
          'memberIds', 'members', 'allowInviteLink', 'updatedAt', 'lastModifiedBy'
        ]);
    }

    // Controlled self-join: authenticated non-member adding ONLY themselves as editor when allowInviteLink == true
    function isLegitimateJoin() {
      return isSignedIn() &&
        !(request.auth.uid in existing().memberIds) &&
        existing().allowInviteLink == true &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().id == existing().id &&
        incoming().type == existing().type &&
        incoming().joinCode == existing().joinCode &&
        incoming().allowInviteLink == existing().allowInviteLink &&
        incoming().memberIds.hasAll(existing().memberIds) &&
        incoming().memberIds.size() == existing().memberIds.size() + 1 &&
        request.auth.uid in incoming().memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds', 'members', 'updatedAt', 'lastModifiedBy'
        ]) &&
        incoming().members[request.auth.uid].userId == request.auth.uid &&
        incoming().members[request.auth.uid].role == 'editor';
    }

    function isValidActivityLog(data, wsId) {
      return data.workspaceId == wsId &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() <= 128 &&
        data.action is string && data.action.size() <= 64 &&
        data.details is string && data.details.size() <= 500 &&
        data.timestamp is number &&
        !('ownerId' in data) &&
        !('memberIds' in data) &&
        !('members' in data) &&
        !('joinCode' in data) &&
        !('allowInviteLink' in data);
    }

    // Strict notification validation: validates sender, recipient, and workspace membership
    function isValidCollaborationNotification(data, uid) {
      return data.userId == uid &&
        data.fromUserId == request.auth.uid &&
        data.fromUserId != uid &&
        data.id is string && data.id.size() <= 128 &&
        data.fromUserName is string && data.fromUserName.size() <= 128 &&
        data.workspaceId is string && data.workspaceId.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.message is string && data.message.size() <= 500 &&
        data.type in ['member_joined', 'task_assigned', 'task_completed', 'note_updated', 'role_changed', 'member_removed', 'workspace_invite'] &&
        data.timestamp is number &&
        exists(/databases/$(database)/documents/shared_workspaces/$(data.workspaceId)) &&
        (
          request.auth.uid == getWorkspaceDoc(data.workspaceId).data.ownerId ||
          request.auth.uid in getWorkspaceDoc(data.workspaceId).data.memberIds
        ) &&
        (
          uid == getWorkspaceDoc(data.workspaceId).data.ownerId ||
          uid in getWorkspaceDoc(data.workspaceId).data.memberIds
        ) &&
        request.resource.data.diff({}).affectedKeys().hasOnly([
          'id', 'userId', 'fromUserId', 'fromUserName', 'workspaceId',
          'workspaceTitle', 'workspaceType', 'type', 'title', 'message', 'read', 'timestamp'
        ]);
    }

    function isValidWorkspaceInvite(data) {
      return data.id is string && data.id.size() <= 64 &&
        data.workspaceId is string && data.workspaceId.size() <= 128 &&
        data.title is string && data.title.size() <= 256 &&
        data.type in ['tasks', 'notes'] &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.ownerName is string && data.ownerName.size() <= 128 &&
        data.allowInviteLink is bool &&
        data.createdAt is number;
    }

    // -------------------------------------------------------------------------
    // User Root and Subcollections
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // Student Profiles Subcollection
      match /profiles/{profileId} {
        allow get: if isOwner(userId) && isValidId(profileId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(profileId) && isValidStudentProfile(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(profileId) && isValidStudentProfile(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(profileId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Subjects Subcollection
      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      // Notes Subcollection
      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(noteId) && isValidNote(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Habits Subcollection
      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(habitId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId) && isValidHabit(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(habitId) && isValidHabit(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      // Goals Subcollection
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId) && isValidGoal(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(goalId) && isValidGoal(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Calendar Events Subcollection
      match /calendar_events/{eventId} {
        allow get: if isOwner(userId) && isValidId(eventId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(eventId) && isValidCalendarEvent(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(eventId) && isValidCalendarEvent(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }

      // Cloud Sync Document
      match /sync/{syncDocId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCloudSync(incoming(), userId);
        allow delete: if isOwner(userId);
      }

      // Collaboration Notifications Subcollection (Recipient owns document, sender validated)
      match /collaboration_notifications/{notifId} {
        allow get: if isOwner(userId) && isValidId(notifId);
        allow list: if isOwner(userId);
        allow create: if isSignedIn() && isValidId(notifId) && isValidCollaborationNotification(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(notifId) &&
          incoming().read is bool &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId) && isValidId(notifId);
      }
    }

    // -------------------------------------------------------------------------
    // Workspace Invites Collection (Minimal metadata for previewing invite codes)
    // -------------------------------------------------------------------------
    match /workspace_invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && resource.data.allowInviteLink == true;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(inviteId) && isValidWorkspaceInvite(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        isParentWorkspaceOwner(incoming().workspaceId);
      allow update: if isSignedIn() && isValidId(inviteId) && isValidWorkspaceInvite(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        isParentWorkspaceOwner(incoming().workspaceId);
      allow delete: if isSignedIn() && isValidId(inviteId) && resource.data.ownerId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Shared Workspaces & Activity Logs
    // -------------------------------------------------------------------------
    match /shared_workspaces/{workspaceId} {
      // Members and owner ONLY can read the full workspace
      allow get: if isSignedIn() && isValidId(workspaceId) && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.ownerId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.memberIds ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(workspaceId) &&
        isValidSharedWorkspace(incoming()) &&
        incoming().ownerId == request.auth.uid &&
        incoming().id == workspaceId &&
        request.auth.uid in incoming().memberIds;
      allow update: if isSignedIn() && isValidId(workspaceId) &&
        isValidSharedWorkspace(incoming()) &&
        (
          isLegitimateOwnerUpdate() ||
          isLegitimateMemberUpdate() ||
          isLegitimateJoin()
        );
      allow delete: if isSignedIn() && isValidId(workspaceId) &&
        resource.data.ownerId == request.auth.uid;

      // Activity logs subcollection (requires membership/ownership of parent workspace)
      match /activities/{activityId} {
        allow get: if isParentWorkspaceMemberOrOwner(workspaceId) && isValidId(activityId);
        allow list: if isParentWorkspaceMemberOrOwner(workspaceId);
        allow create: if isParentWorkspaceMemberOrOwner(workspaceId) &&
          isValidId(activityId) &&
          isValidActivityLog(incoming(), workspaceId) &&
          incoming().userId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
